# Backend environment example
# Copy this file to backend/.env and fill values before running.

# Server
PORT=3001

# Firebase (optional) - either set GOOGLE_APPLICATION_CREDENTIALS to a JSON
# service account path or provide the following variables if using direct creds
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Railway (if deploying via Railway you do NOT need to set this here; add the
# token as a GitHub Actions secret named RAILWAY_API_TOKEN instead)
# RAILWAY_API_TOKEN=your-railway-api-token
